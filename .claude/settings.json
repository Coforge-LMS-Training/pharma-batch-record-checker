{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pytest-run.sh",
            "timeout": 120,
            "statusMessage": "Running pytest (see .claude/hooks/pytest-run.sh)"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-check.sh",
            "timeout": 60,
            "statusMessage": "Linting edited Python file with ruff (see .claude/hooks/ruff-check.sh)"
          }
        ]
      }
    ]
  }
}
